# Produce prediction runs on the locally trained model in models/ (no key needed).

# GEMINI_API_KEY: enables the Generative AI rescue plans and the agentic Kitchen Rescue Agent
# (src/ai_engines). SERVER ONLY: never exposed to the browser. Free key: https://aistudio.google.com/apikey
# Without it, both features run in a labelled offline mode.
GEMINI_API_KEY=""
# Optional: force a specific model instead of auto-selecting the newest stable flash model
# GEMINI_MODEL="gemini-2.5-flash"

# OPENWEATHER_API_KEY for environmental data
OPENWEATHER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key
GOOGLE_MAPS_PLATFORM_KEY=""
