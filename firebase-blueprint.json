{
  "entities": {
    "Prediction": {
      "title": "Prediction Result",
      "description": "Store individual produce freshness predictions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "produceType": { "type": "string" },
        "qualityScore": { "type": "number" },
        "rulHours": { "type": "number" },
        "temperatureK": { "type": "number" },
        "humidity": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "imageUrl": { "type": "string" },
        "isCorrect": { "type": "boolean" },
        "correctedType": { "type": "string" },
        "alertEnabled": { "type": "boolean" },
        "alertThreshold": { "type": "number" }
      },
      "required": ["userId", "produceType", "qualityScore", "rulHours", "timestamp"]
    }
  },
  "firestore": {
    "predictions": {
      "schema": "Prediction",
      "description": "A collection of all produce freshness predictions"
    }
  }
}
